{
  "_metadata": {
    "original_repository": "https://github.com/dhopp1/nowcasting_benchmark",
    "reproduction_by": "Sermet Pekin",
    "reproduction_repository": "https://github.com/SermetPekin/nowcasting_benchmark",
    "purpose": "Configuration for automated notebook execution system with modern package compatibility",
    "status": "Work in Progress - ongoing reproduction verification",
    "date": "November 2025"
  },
  "execution": {
    "default_timeout": 60,
    "timeout_by_category": {
      "regression": 60,
      "tree": 120,
      "timeseries": 180,
      "neural": 240,
      "bayesian": 600
    },
    "global_timeout_multiplier": 1.0
  },
  "skip_notebooks": {
    "py_var.ipynb": "pyflux not compatible with Apple Silicon/modern Python",
    "py_deepvar.ipynb": "gluonts/mxnet not compatible with Apple Silicon",
    "py_gb.ipynb": "Gradient Boosting takes longer to execute"
  },
  "notebook_patterns": {
    "include": [
      "methodologies/py_*.ipynb",
      "methodologies/r_*.ipynb"
    ],
    "exclude": []
  },
  "cache": {
    "enabled": true,
    "cache_file": ".notebook_execution_cache.json",
    "force_fresh_run": false
  },
  "output": {
    "results_file": "notebook_execution_results.csv",
    "log_file": "NOTEBOOK_EXECUTION_LOG.md"
  },
  "categories": {
    "py_ols.ipynb": "regression",
    "py_lasso.ipynb": "regression",
    "py_ridge.ipynb": "regression",
    "py_elasticnet.ipynb": "regression",
    "py_dt.ipynb": "tree",
    "py_rf.ipynb": "tree",
    "py_gb.ipynb": "tree",
    "py_xgboost.ipynb": "tree",
    "py_arma.ipynb": "timeseries",
    "py_mlp.ipynb": "neural",
    "py_lstm.ipynb": "neural",
    "r_bvar.ipynb": "bayesian",
    "r_dfm.ipynb": "timeseries",
    "r_midas.ipynb": "timeseries",
    "r_midasml.ipynb": "timeseries",
    "r_lstm.ipynb": "neural",
    "py_var.ipynb": "timeseries",
    "py_deepvar.ipynb": "neural"
  }
}
